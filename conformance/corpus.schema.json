{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R8 conformance suite, format version 1",
  "type": "object",
  "required": [
    "$corpus",
    "description",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "$corpus": {
      "const": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "ir": {
      "description": "One IR document, or an array of IR documents, one per namespace, used by the value operations.",
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        }
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "path": {
          "type": "string",
          "pattern": "^(/([^~/]|~[01])*)*$"
        },
        "rule": {
          "type": "string"
        },
        "rule_index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "errors": {
      "type": "object",
      "required": [
        "errors"
      ],
      "additionalProperties": false,
      "properties": {
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    "qualified": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*::[A-Za-z][A-Za-z0-9_]*$"
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "op",
        "input",
        "expect"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string"
        },
        "op": {
          "enum": [
            "declare",
            "decode",
            "canonical",
            "hash",
            "dispatch"
          ]
        },
        "type": {
          "$ref": "#/$defs/qualified"
        },
        "input": true,
        "options": {
          "type": "object"
        },
        "expect": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "op": {
              "const": "declare"
            },
            "input": {
              "type": "object"
            },
            "expect": {
              "oneOf": [
                {
                  "$ref": "#/$defs/errors"
                },
                {
                  "type": "object",
                  "required": [
                    "parse_error"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "parse_error": {
                      "const": true
                    }
                  }
                }
              ]
            }
          },
          "not": {
            "required": [
              "type"
            ]
          }
        },
        {
          "required": [
            "type"
          ],
          "properties": {
            "op": {
              "const": "decode"
            },
            "expect": {
              "oneOf": [
                {
                  "$ref": "#/$defs/errors"
                },
                {
                  "type": "object",
                  "required": [
                    "valid"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "valid": {
                      "const": true
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "required": [
            "type"
          ],
          "properties": {
            "op": {
              "const": "canonical"
            },
            "expect": {
              "type": "object",
              "required": [
                "json"
              ],
              "additionalProperties": false,
              "properties": {
                "json": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "required": [
            "type"
          ],
          "properties": {
            "op": {
              "const": "hash"
            },
            "options": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "hash_key": {
                  "type": "string"
                }
              }
            },
            "expect": {
              "type": "object",
              "required": [
                "hash"
              ],
              "additionalProperties": false,
              "properties": {
                "hash": {
                  "type": "string",
                  "pattern": "^(sha256|sha256-partial):[0-9a-f]{64}$|^hmac-sha256:[0-9a-f]{8}:[0-9a-f]{64}$"
                }
              }
            }
          }
        },
        {
          "required": [
            "type"
          ],
          "properties": {
            "op": {
              "const": "dispatch"
            },
            "input": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/qualified"
                  },
                  {
                    "type": "object",
                    "required": [
                      "classes"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "classes": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "expect": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "impl"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "impl": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "default"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "default": {
                      "const": true
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "ambiguous"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "ambiguous": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "stale"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "stale": {
                      "$ref": "#/$defs/qualified"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  }
}
