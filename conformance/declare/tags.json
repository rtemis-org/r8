    {
      "id": "tags-distinct",
      "description": "Two implementors with distinct tag values.",
      "op": "declare",
      "input": {
        "$ir": 1,
        "namespace": "ns",
        "types": [
          {
            "kind": "struct",
            "name": "A",
            "description": "",
            "version": 1,
            "fields": [
              {
                "name": "x",
                "type": {
                  "kind": "double"
                },
                "description": ""
              }
            ]
          },
          {
            "kind": "struct",
            "name": "B",
            "description": "",
            "version": 1,
            "fields": [
              {
                "name": "y",
                "type": {
                  "kind": "double"
                },
                "description": ""
              }
            ]
          }
        ],
        "traits": [
          {
            "name": "Algorithm",
            "description": "",
            "methods": [
              {
                "name": "fit",
                "description": "",
                "params": [
                  "x"
                ]
              }
            ],
            "tag": "algorithm"
          }
        ],
        "impls": [
          {
            "trait": "ns::Algorithm",
            "target": {
              "kind": "type",
              "name": "ns::A"
            },
            "methods": []
          },
          {
            "trait": "ns::Algorithm",
            "target": {
              "kind": "type",
              "name": "ns::B"
            },
            "methods": [],
            "tag_value": "Bee"
          }
        ]
      },
      "expect": {
        "errors": []
      }
    },
