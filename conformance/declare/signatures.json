          },
          {
            "kind": "struct",
            "name": "Other",
            "description": "",
            "version": 1,
            "fields": [
              {
                "name": "o",
                "type": {
                  "kind": "double"
                },
                "description": ""
              }
            ]
          }
        ],
        "traits": [
          {
            "name": "Fit",
            "description": "",
            "methods": [
              {
                "name": "fit",
                "description": "",
                "params": [
                  "x",
                  {
                    "name": "n",
                    "type": {
                      "kind": "integer"
