{
  "$corpus": 1,
  "description": "`extends`: the flattened fields and rules of a child, checked against a parent in the same document.",
  "cases": [
    {
      "id": "chain",
      "description": "A three-level chain: each child holds its parent's fields and rules first, marked with the declaring ancestor.",
      "op": "declare",
      "input": {
        "$ir": 1,
        "namespace": "ns",
        "types": [
          {
            "kind": "struct",
            "name": "A",
            "description": "",
            "version": 1,
            "fields": [
              {
                "name": "a",
                "type": {
                  "kind": "double"
                },
                "description": ""
              }
            ],
            "rules": [
              {
                "id": "A_POS",
                "invariant": {
                  ">": [
                    {
                      "var": "a"
                    },
                    0
                  ]
                }
              }
            ]
          },
          {
            "kind": "struct",
            "name": "B",
            "description": "",
            "version": 1,
            "fields": [
              {
                "name": "a",
                "type": {
                  "kind": "double"
                },
                "description": "",
                "inherited_from": "ns::A"
              },
              {
                "name": "b",
                "type": {
                  "kind": "double"
                },
                "description": ""
              }
            ],
            "extends": "ns::A",
            "rules": [
              {
                "id": "A_POS",
                "invariant": {
                  ">": [
                    {
                      "var": "a"
                    },
                    0
                  ]
                },
                "inherited_from": "ns::A"
              },
              {
                "id": "B_POS",
                "invariant": {
                  ">": [
                    {
                      "var": "b"
                    },
                    0
                  ]
                }
              }
            ]
          },
          {
            "kind": "struct",
            "name": "C",
            "description": "",
            "version": 1,
            "fields": [
              {
                "name": "a",
                "type": {
                  "kind": "double"
                },
                "description": "",
                "inherited_from": "ns::A"
              },
              {
                "name": "b",
                "type": {
                  "kind": "double"
                },
                "description": "",
                "inherited_from": "ns::B"
              },
              {
                "name": "c",
                "type": {
                  "kind": "double"
                },
                "description": ""
              }
            ],
            "extends": "ns::B",
            "rules": [
              {
                "id": "A_POS",
                "invariant": {
                  ">": [
                    {
                      "var": "a"
                    },
                    0
                  ]
                },
                "inherited_from": "ns::A"
              },
              {
                "id": "B_POS",
                "invariant": {
                  ">": [
                    {
                      "var": "b"
                    },
                    0
                  ]
                },
                "inherited_from": "ns::B"
              },
              {
                "id": "C_POS",
                "invariant": {
                  ">": [
                    {
                      "var": "c"
                    },
                    0
                  ]
