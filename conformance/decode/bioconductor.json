              },
              "description": "Feature annotations, one row per feature.",
              "inherited_from": "SummarizedExperiment::SummarizedExperiment"
            },
            {
              "name": "col_names",
              "type": {
                "kind": "option",
                "inner": {
                  "kind": "vec",
                  "element": {
                    "kind": "character"
                  }
                }
              },
              "description": "Sample names.",
              "inherited_from": "SummarizedExperiment::SummarizedExperiment"
            },
            {
              "name": "col_data",
              "type": {
                "kind": "table",
                "columns": [],
                "open": true
              },
              "description": "Sample annotations, one row per sample.",
              "inherited_from": "SummarizedExperiment::SummarizedExperiment"
            },
            {
              "name": "metadata",
              "type": {
                "kind": "json"
              },
              "default": {},
              "description": "Free-form metadata with a JSON form.",
              "inherited_from": "SummarizedExperiment::SummarizedExperiment"
            },
            {
              "name": "row_ranges",
              "type": {
                "kind": "named",
                "name": "SummarizedExperiment::RowRanges"
              },
              "description": "Genomic ranges of the features; their metadata columns hold the feature annotations."
            }
          ],
          "extends": "SummarizedExperiment::SummarizedExperiment",
          "rules": [
            {
              "id": "RSE_NO_NAMES",
              "invariant": {
                "is_null": [
                  {
                    "var": "row_names"
                  }
                ]
              },
              "message": "Feature names come from row_ranges."
            },
            {
              "id": "RSE_NO_ROW_DATA",
              "invariant": {
                "===": [
                  {
                    "ncol": [
                      {
                        "var": "row_data"
                      }
                    ]
                  },
                  0
                ]
              },
              "message": "Feature annotations live in the metadata columns of row_ranges."
            },
            {
              "id": "ROW_RANGES_LENGTH",
              "invariant": {
                "===": [
                  {
                    "nrow": [
                      {
                        "var": "row_ranges.ranges"
                      }
                    ]
                  },
                  {
                    "nrow": [
                      {
                        "var": "row_data"
                      }
                    ]
                  }
                ]
              },
              "when": {
                "is_variant": [
                  {
                    "var": "row_ranges"
                  },
                  "GRanges"
                ]
              },
              "message": "row_ranges has one range per feature."
            }
          ]
        }
      ]
    }
