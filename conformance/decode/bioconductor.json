              "inherited_from": "SummarizedExperiment::SummarizedExperiment"
            },
            {
              "name": "row_names",
              "type": {
                "kind": "option",
                "inner": {
                  "kind": "vec",
                  "element": {
                    "kind": "character"
                  }
                }
              },
              "description": "Feature names.",
              "inherited_from": "SummarizedExperiment::SummarizedExperiment"
            },
            {
              "name": "row_data",
              "type": {
                "kind": "table",
                "columns": [],
