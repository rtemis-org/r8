  "description": "Values of the Bioconductor exercise types, resolved across the Seqinfo, GenomicRanges, and SummarizedExperiment namespaces.",
  "ir": [
    {
      "$ir": 1,
      "namespace": "Seqinfo",
      "types": [
        {
          "kind": "struct",
          "name": "Seqinfo",
          "description": "Sequence information: one entry per sequence.",
          "version": 1,
          "fields": [
            {
              "name": "seqnames",
              "type": {
                "kind": "vec",
                "element": {
                  "kind": "character"
                },
                "unique": true
              },
              "description": "Sequence names."
            },
            {
              "name": "seqlengths",
              "type": {
                "kind": "vec",
                "element": {
                  "kind": "option",
                  "inner": {
                    "kind": "integer",
                    "min": 0
                  }
                }
              },
              "description": "Sequence lengths; missing when unknown."
            },
            {
              "name": "is_circular",
              "type": {
                "kind": "vec",
                "element": {
                  "kind": "option",
                  "inner": {
                    "kind": "logical"
                  }
                }
              },
              "description": "Whether each sequence is circular; missing when unknown."
            },
            {
              "name": "genome",
              "type": {
                "kind": "vec",
                "element": {
                  "kind": "option",
                  "inner": {
                    "kind": "character"
                  }
                }
              },
              "description": "Genome assembly of each sequence; missing when unknown."
            }
          ],
          "rules": [
            {
              "id": "SEQINFO_LENGTHS",
              "invariant": {
                "and": [
                  {
                    "===": [
                      {
                        "length": [
                          {
                            "var": "seqlengths"
                          }
                        ]
                      },
                      {
                        "length": [
                          {
                            "var": "seqnames"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "===": [
                      {
                        "length": [
                          {
                            "var": "is_circular"
                          }
                        ]
                      },
                      {
                        "length": [
                          {
                            "var": "seqnames"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "===": [
                      {
                        "length": [
                          {
                            "var": "genome"
                          }
                        ]
                      },
                      {
                        "length": [
                          {
                            "var": "seqnames"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "message": "seqnames, seqlengths, is_circular, and genome have one entry per sequence."
            }
          ]
        }
      ]
    },
    {
      "$ir": 1,
      "namespace": "GenomicRanges",
      "types": [
        {
          "kind": "struct",
          "name": "GRanges",
          "description": "Genomic ranges: one row per range, with sequence information.",
          "version": 1,
          "fields": [
            {
              "name": "ranges",
              "type": {
                "kind": "table",
                "columns": [
                  {
                    "name": "seqnames",
                    "type": {
                      "kind": "factor"
                    },
                    "description": "Sequence of each range, a dense factor; an Rle input is expanded by r8_conform()."
                  },
                  {
                    "name": "start",
                    "type": {
                      "kind": "integer"
                    },
                    "description": "First position, 1-based."
                  },
                  {
                    "name": "width",
                    "type": {
                      "kind": "integer",
                      "min": 0
                    },
                    "description": "Number of positions."
                  },
                  {
                    "name": "strand",
                    "type": {
                      "kind": "factor",
                      "levels": [
                        "+",
                        "-",
                        "*"
                      ]
                    },
                    "description": "Strand."
                  }
                ],
                "rules": [
                  {
                    "id": "END_FITS",
                    "invariant": {
                      "<=": [
                        {
                          "-": [
                            {
                              "+": [
                                {
                                  "var": "start"
                                },
                                {
                                  "var": "width"
                                }
                              ]
                            },
                            1
                          ]
                        },
                        2147483647
                      ]
                    },
                    "message": "The end position, start + width - 1, fits in an integer."
                  }
                ]
              },
              "description": "One row per range."
            },
            {
              "name": "mcols",
              "type": {
                "kind": "table",
                "columns": [],
                "open": true
              },
              "description": "Metadata columns, one row per range, chosen by the data."
            },
            {
              "name": "names",
              "type": {
                "kind": "option",
                "inner": {
                  "kind": "vec",
                  "element": {
                    "kind": "character"
                  }
                }
              },
              "description": "Range names."
            },
            {
              "name": "seqinfo",
              "type": {
                "kind": "named",
                "name": "Seqinfo::Seqinfo"
              },
              "description": "Sequence information."
            },
            {
              "name": "metadata",
              "type": {
                "kind": "json"
              },
              "default": {},
              "description": "Free-form metadata with a JSON form."
            }
          ],
          "rules": [
            {
              "id": "SEQNAMES_LEVELS",
              "invariant": {
                "===": [
                  {
                    "levels": [
                      {
                        "var": "ranges.seqnames"
                      }
                    ]
                  },
                  {
                    "var": "seqinfo.seqnames"
                  }
                ]
              },
              "message": "The sequence factor's levels are the sequence names of seqinfo."
            },
            {
              "id": "MCOLS_ROWS",
              "invariant": {
                "===": [
                  {
                    "nrow": [
                      {
                        "var": "mcols"
                      }
                    ]
                  },
                  {
                    "nrow": [
                      {
                        "var": "ranges"
                      }
                    ]
                  }
                ]
              },
              "message": "mcols has one row per range."
            },
            {
              "id": "NAMES_LENGTH",
              "invariant": {
                "===": [
                  {
                    "length": [
                      {
                        "var": "names"
                      }
                    ]
                  },
                  {
                    "nrow": [
                      {
                        "var": "ranges"
                      }
                    ]
                  }
                ]
              },
              "message": "names has one entry per range."
            }
          ]
        },
        {
          "kind": "struct",
          "name": "GRangesList",
          "description": "A list of GRanges, stored concatenated with element ends.",
          "version": 1,
          "fields": [
            {
              "name": "unlisted",
              "type": {
                "kind": "named",
                "name": "GenomicRanges::GRanges"
              },
              "description": "The ranges of every element, concatenated."
            },
            {
              "name": "ends",
              "type": {
                "kind": "vec",
                "element": {
                  "kind": "integer",
                  "min": 0
                }
              },
              "description": "End of each element in the concatenated ranges (PartitioningByEnd)."
            },
            {
              "name": "names",
              "type": {
                "kind": "option",
                "inner": {
                  "kind": "vec",
                  "element": {
                    "kind": "character"
                  }
                }
              },
              "description": "Element names."
            },
            {
              "name": "mcols",
              "type": {
                "kind": "table",
                "columns": [],
                "open": true
              },
              "description": "Metadata columns, one row per element."
            },
            {
              "name": "metadata",
              "type": {
                "kind": "json"
              },
              "default": {},
              "description": "Free-form metadata with a JSON form."
            }
          ],
          "rules": [
            {
              "id": "ENDS_ORDER",
              "invariant": {
                "non_decreasing": [
                  {
                    "var": "ends"
                  }
                ]
              },
              "message": "Element ends are non-decreasing."
            }
          ]
        }
      ]
    },
    {
      "$ir": 1,
      "namespace": "SummarizedExperiment",
      "types": [
        {
          "kind": "enum",
          "name": "AssayData",
          "description": "The values of one assay, features by samples; on-disk DelayedArray assays are runtime-only through a host-class impl.",
          "tag": "type",
          "version": 1,
          "variants": [
            {
              "name": "Integer",
              "description": "",
              "shape": "struct",
              "fields": [
                {
