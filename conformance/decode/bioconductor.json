        {
          "kind": "struct",
          "name": "SummarizedExperiment",
          "description": "Assays of features by samples, with feature and sample annotations.",
          "version": 1,
          "fields": [
            {
              "name": "assays",
              "type": {
                "kind": "ordered_map",
                "value": {
                  "kind": "named",
                  "name": "SummarizedExperiment::AssayData"
                }
              },
              "description": "Assays in order; assay(x) is the first."
            },
            {
              "name": "row_names",
              "type": {
                "kind": "option",
                "inner": {
                  "kind": "vec",
                  "element": {
                    "kind": "character"
                  }
                }
              },
              "description": "Feature names."
            },
            {
              "name": "row_data",
              "type": {
                "kind": "table",
                "columns": [],
                "open": true
              },
              "description": "Feature annotations, one row per feature."
            },
            {
              "name": "col_names",
              "type": {
                "kind": "option",
                "inner": {
                  "kind": "vec",
                  "element": {
                    "kind": "character"
                  }
                }
              },
              "description": "Sample names."
            },
            {
              "name": "col_data",
              "type": {
                "kind": "table",
                "columns": [],
                "open": true
              },
              "description": "Sample annotations, one row per sample."
            },
            {
              "name": "metadata",
              "type": {
                "kind": "json"
              },
              "default": {},
              "description": "Free-form metadata with a JSON form."
            }
          ],
          "rules": [
            {
              "id": "ASSAY_ROWS",
              "invariant": {
                "all": [
                  {
                    "var": "assays"
                  },
                  {
                    "===": [
                      {
                        "nrow": [
                          {
                            "var": ".x.values"
                          }
                        ]
                      },
                      {
                        "nrow": [
                          {
                            "var": "row_data"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "message": "Every assay has one row per feature."
            },
            {
              "id": "ASSAY_COLS",
              "invariant": {
                "all": [
                  {
                    "var": "assays"
                  },
                  {
                    "===": [
                      {
                        "ncol": [
                          {
                            "var": ".x.values"
                          }
                        ]
                      },
                      {
                        "nrow": [
                          {
                            "var": "col_data"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "message": "Every assay has one column per sample."
            },
            {
              "id": "COL_NAMES_LENGTH",
              "invariant": {
                "===": [
                  {
                    "length": [
                      {
                        "var": "col_names"
                      }
                    ]
                  },
                  {
                    "nrow": [
                      {
                        "var": "col_data"
                      }
                    ]
                  }
                ]
              },
              "message": "col_names has one entry per sample."
            }
          ]
        },
