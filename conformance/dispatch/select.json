    {
      "id": "exact-tuple",
      "description": "Each argument of a type an impl names.",
      "op": "dispatch",
      "type": "core::Combine",
      "input": [
        "core::A",
        "core::B"
      ],
      "expect": {
        "impl": [
          "core::A",
          "core::B"
        ]
      }
    },
    {
      "id": "more-specific-first",
      "description": "A child in the first position.",
      "op": "dispatch",
      "type": "core::Combine",
      "input": [
        "core::A1",
        "core::B"
      ],
      "expect": {
        "impl": [
          "core::A1",
          "core::B"
        ]
      }
    },
    {
      "id": "through-ancestors",
      "description": "Children in both positions, served by the meet of their parents.",
      "op": "dispatch",
      "type": "core::Combine",
      "input": [
        "core::A2",
        "core::B1"
      ],
      "expect": {
        "impl": [
          "core::A1",
          "core::B1"
        ]
      }
    },
    {
      "id": "grandchild-first",
      "description": "A grandchild in the first position.",
