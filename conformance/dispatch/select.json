      "description": "A position any matches a value of another type.",
      "op": "dispatch",
      "type": "core::Combine",
      "input": [
        "core::C",
        "core::A"
      ],
      "expect": {
        "impl": [
          "core::C",
          "any"
        ]
      }
    },
    {
      "id": "any-position-null",
      "description": "A position any matches a value no type names.",
      "op": "dispatch",
      "type": "core::Combine",
      "input": [
        "core::C",
        null
      ],
      "expect": {
        "impl": [
          "core::C",
          "any"
        ]
      }
    },
    {
      "id": "no-impl",
      "description": "No impl applies: the trait's default implementation.",
      "op": "dispatch",
      "type": "core::Combine",
      "input": [
        "core::B",
        "core::A"
      ],
      "expect": {
        "default": true
      }
    },
    {
      "id": "single-dispatch-ancestor",
      "description": "A child served by its parent's impl.",
      "op": "dispatch",
      "type": "core::Describe",
      "input": [
        "core::A1"
      ],
      "expect": {
        "impl": [
          "core::A"
        ]
      }
    },
    {
      "id": "single-dispatch-own",
      "description": "A grandchild with its own impl.",
      "op": "dispatch",
      "type": "core::Describe",
      "input": [
        "core::A2"
      ],
      "expect": {
        "impl": [
          "core::A2"
        ]
      }
    },
    {
      "id": "host-class",
      "description": "An object whose class vector holds a class an impl names.",
      "op": "dispatch",
      "type": "core::Describe",
      "input": [
        {
          "classes": [
            "tbl_df",
            "tbl",
            "data.frame"
          ]
        }
      ],
      "expect": {
        "impl": [
          "data.frame"
        ]
      }
    },
    {
      "id": "host-class-none",
      "description": "An object of no class an impl names.",
      "op": "dispatch",
      "type": "core::Describe",
      "input": [
        {
          "classes": [
            "matrix",
            "array"
          ]
        }
      ],
      "expect": {
        "default": true
      }
    },
    {
      "id": "non-prefix-positions",
      "description": "A trait that dispatches on its first and third arguments.",
      "op": "dispatch",
      "type": "core::Place",
      "input": [
        "core::A2",
        "core::C"
      ],
      "expect": {
        "impl": [
          "core::A",
          "core::C"
        ]
      }
    },
    {
      "id": "ambiguous-across-namespaces",
      "description": "Impls of two namespaces, each more specific in one position.",
      "op": "dispatch",
      "type": "core::Combine",
      "input": [
        "pa::A3",
        "pb::B3"
      ],
      "expect": {
        "ambiguous": [
          [
            "core::A",
            "pb::B3"
          ],
          [
            "pa::A3",
            "core::B"
          ]
        ]
      }
    },
    {
      "id": "other-namespace-impl",
      "description": "An impl of another namespace for its own child type.",
      "op": "dispatch",
      "type": "core::Combine",
      "input": [
        "pa::A3",
        "core::B"
      ],
      "expect": {
        "impl": [
          "pa::A3",
          "core::B"
        ]
      }
    },
    {
      "id": "ambiguous-with-trait-namespace",
      "description": "An impl of another namespace and one of the trait's, each more specific in one position.",
      "op": "dispatch",
      "type": "core::Combine",
      "input": [
        "pa::A3",
        "core::B1"
      ],
      "expect": {
        "ambiguous": [
          [
            "core::A",
            "core::B1"
          ],
          [
            "pa::A3",
            "core::B"
          ]
        ]
      }
    },
    {
      "id": "host-class-second",
      "description": "A host class in the second position, more specific than any.",
      "op": "dispatch",
      "type": "core::Combine",
      "input": [
        "core::C",
        {
          "classes": [
            "tbl_df",
            "tbl",
            "data.frame"
          ]
        }
      ],
      "expect": {
        "impl": [
          "core::C",
          "data.frame"
        ]
      }
    },
    {
      "id": "host-class-second-other",
      "description": "An object of another class in the second position: any.",
      "op": "dispatch",
      "type": "core::Combine",
      "input": [
        "core::C",
        {
          "classes": [
            "matrix",
            "array",
            "double",
            "numeric"
          ]
        }
      ],
      "expect": {
        "impl": [
          "core::C",
          "any"
        ]
      }
    },
    {
      "id": "host-class-first",
      "description": "A host class in the first position and an R8 type's child in the second.",
      "op": "dispatch",
      "type": "core::Combine",
      "input": [
        {
          "classes": [
            "data.frame"
          ]
        },
        "core::B1"
      ],
      "expect": {
        "impl": [
          "data.frame",
          "core::B"
        ]
      }
    },
    {
      "id": "forged-class",
      "description": "An object whose class vector names an R8 type is not a value of that type.",
      "op": "dispatch",
      "type": "core::Describe",
      "input": [
        {
          "classes": [
            "core::A",
            "r8_value"
          ]
        }
      ],
      "expect": {
        "default": true
      }
    },
    {
      "id": "type-not-host",
      "description": "A value of an R8 type does not match a host-class position.",
      "op": "dispatch",
      "type": "core::Combine",
      "input": [
        "core::C",
        "core::A"
      ],
      "expect": {
