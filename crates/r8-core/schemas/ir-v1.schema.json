{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$ir": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "description": "The IR format version.",
      "const": 1
    },
    "namespace": {
      "$ref": "#/$defs/Name"
    },
    "types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TypeDef"
      }
    },
    "traits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TraitDef"
      }
    },
    "impls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ImplDef"
      }
    }
  },
  "required": [
    "$ir",
    "namespace"
  ],
  "description": "The declarations of one namespace.",
  "title": "R8 IR document, version 1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Name": {
      "description": "A name: a letter followed by letters, digits, and underscores; not an R reserved word or `self`, `Self`, `super`, or `crate`.",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "not": {
        "enum": [
          "if",
          "else",
          "repeat",
          "while",
          "function",
          "for",
          "in",
          "next",
          "break",
          "TRUE",
          "FALSE",
          "NULL",
          "Inf",
          "NaN",
          "NA",
          "NA_integer_",
          "NA_real_",
          "NA_character_",
          "NA_complex_",
          "self",
          "Self",
          "super",
          "crate"
        ]
      }
    },
    "TypeDef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "const": "struct"
            },
            "name": {
              "$ref": "#/$defs/Name"
            },
            "description": {
              "type": "string",
              "default": ""
            },
            "version": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/FieldDef"
              }
            },
            "extends": {
              "anyOf": [
                {
                  "$ref": "#/$defs/QualifiedName"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The parent, whose fields are flattened into `fields`."
            },
            "rules": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/RuleDef"
              }
            },
            "migrations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Migration"
              }
            },
            "aliases": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/QualifiedName"
              },
              "description": "Former qualified names, which readers accept."
            },
            "provenance": {
              "type": "boolean",
              "description": "Values carry a provenance record."
            },
            "s4": {
              "type": "boolean",
              "description": "Registered with `methods::setOldClass()`."
            },
            "extensions": {
              "type": "object",
              "additionalProperties": true,
              "description": "Namespaced extensions that R8 stores and exports and does not\ninterpret."
            }
          },
          "required": [
            "kind",
            "name",
            "version",
            "fields"
          ],
          "description": "`new_struct()`: a product type."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "const": "enum"
            },
            "name": {
              "$ref": "#/$defs/Name"
            },
            "description": {
              "type": "string",
              "default": ""
            },
            "tag": {
              "$ref": "#/$defs/Name",
              "description": "The member that holds the variant name of a struct variant.",
              "default": "type"
            },
            "version": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "variants": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/VariantDef"
              }
            },
            "migrations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Migration"
              }
            },
            "aliases": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/QualifiedName"
              },
              "description": "Former qualified names, which readers accept."
            },
            "extensions": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "required": [
            "kind",
            "name",
            "version",
            "variants"
          ],
          "description": "`new_enum()`: a sum type."
        }
      ],
      "description": "A struct or an enum."
    },
    "FieldDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/Name"
        },
        "type": {
          "$ref": "#/$defs/FieldType"
        },
        "default": {
          "description": "A literal default in the field's JSON form, filled by the constructor\nand by `r8_from_json()`."
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "sensitive": {
          "type": "boolean"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "description": "A UCUM code."
        },
        "external": {
          "type": "boolean",
          "description": "Written to an Arrow IPC file by `write_json()`."
        },
        "unique": {
          "type": "boolean",
          "description": "A table column whose values are distinct."
        },
        "optional": {
          "type": "boolean",
          "description": "A table column that may be absent from the table, as distinct from a\npresent column with missing cells, which is `option()`."
        },
        "inherited_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/QualifiedName"
            },
            {
              "type": "null"
            }
          ],
          "description": "The ancestor that declared the field, for a field that `extends`\nflattened into a child."
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true,
          "description": "Namespaced extensions, such as `\"rtemis:tunable\"`, which R8 stores and\nexports and does not interpret."
        }
      },
      "required": [
        "name",
        "type"
      ],
      "description": "A field of a struct, a struct variant, a table, or a trait's required\nfields."
    },
    "FieldType": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "logical"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "description": "`type_logical()`: a boolean, not `NA`."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "const": "integer"
            },
            "min": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32"
            },
            "max": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32"
            },
            "exclusive_min": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32"
            },
            "exclusive_max": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32"
            },
            "enum": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "integer",
                "format": "int32"
              },
              "description": "The admitted values, when the domain is a closed set."
            }
          },
          "description": "`type_integer()`.",
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "const": "double"
            },
            "min": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "max": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "exclusive_min": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "exclusive_max": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "finite": {
              "type": "boolean"
            },
            "enum": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "number",
                "format": "double"
              }
            }
          },
          "description": "`type_double()`.",
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "const": "character"
            },
            "pattern": {
              "type": [
                "string",
                "null"
              ],
              "description": "A regular expression in Rust `regex` syntax, compiled at declaration."
            },
            "enum": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            }
          },
          "description": "`type_character()`: a string without U+0000, not `NA`.",
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "raw"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "description": "`type_raw()`: bytes, written as padded base64 (RFC 4648 section 4)."
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "date"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "description": "`type_date()`: a calendar date from 0000-01-01 to 9999-12-31."
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "posixct"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "description": "`type_posixct()`: a UTC instant in microseconds, from 0000-01-01 to\n2112-09-17."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "const": "factor"
            },
            "levels": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "ordered": {
              "type": "boolean"
            }
          },
          "required": [
            "kind"
          ],
          "description": "`type_factor()`: a vector of categorical values."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "const": "matrix"
            },
            "element": {
              "$ref": "#/$defs/FieldType"
            },
            "nrow": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "ncol": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "element"
          ],
          "description": "`type_matrix(T, nrow, ncol)`: a dense matrix of a scalar type."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "const": "array"
            },
            "element": {
              "$ref": "#/$defs/FieldType"
            },
            "dim": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              }
            }
          },
          "required": [
            "kind",
            "element"
          ],
          "description": "`type_array(T, dim)`: a dense array of a scalar type."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "const": "sparse_matrix"
            },
            "element": {
              "$ref": "#/$defs/FieldType"
            },
            "nrow": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "ncol": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "element"
          ],
          "description": "`type_sparse_matrix(T)`: a matrix in compressed sparse column form,\n`dgCMatrix` in R and `{\"shape\", \"indptr\", \"indices\", \"data\"}` in JSON."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "const": "matrix_of"
            },
            "of": {
              "$ref": "#/$defs/QualifiedName"
            }
          },
          "required": [
            "kind",
            "of"
          ],
          "description": "`type_matrix(S)`: a matrix whose columns are the fields of the struct\n`of`, all of one scalar type."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "const": "table"
            },
            "columns": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/FieldDef"
              }
            },
            "open": {
              "type": "boolean"
            },
            "rules": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/RuleDef"
              }
            }
          },
          "required": [
            "kind",
            "columns"
          ],
          "description": "`type_table(columns, open, rules)`: a data.frame of equal-length\ncolumns. An open table also accepts columns the declaration does not\nname, each of a column type, whose types its JSON records in\n`\"$columns\"`. Each rule runs once per row and reads the row's columns\nby name."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "const": "table_of"
            },
            "of": {
              "$ref": "#/$defs/QualifiedName"
            }
          },
          "required": [
            "kind",
            "of"
          ],
          "description": "`type_table(S)`: a data.frame whose columns are the fields of the\nstruct `of`."
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "json"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "description": "`type_json()`: any JSON value."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "const": "r"
            },
            "class": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "class"
          ],
          "description": "`type_r(class)`: an R value of a class, runtime-only."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "const": "vec"
            },
            "element": {
              "$ref": "#/$defs/FieldType"
            },
            "min_length": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "max_length": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "unique": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "element"
          ],
          "description": "`vec(T, min_length, max_length, unique)`."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "const": "option"
            },
            "inner": {
              "$ref": "#/$defs/FieldType"
            },
            "resolve": {
              "$ref": "#/$defs/Resolve"
            }
          },
          "required": [
            "kind",
            "inner"
          ],
          "description": "`option(T, resolve)`."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "const": "hashmap"
            },
            "value": {
              "$ref": "#/$defs/FieldType"
            },
            "keys": {
              "$ref": "#/$defs/CharacterType"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "description": "`hashmap(T, keys)`: string keys, sorted at construction."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "const": "ordered_map"
            },
            "value": {
              "$ref": "#/$defs/FieldType"
            },
            "keys": {
              "$ref": "#/$defs/CharacterType"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "description": "`ordered_map(T, keys)`: unique string keys in insertion order; a named\nlist in R and an array of `{\"name\", \"value\"}` pairs in JSON. Order is\npart of the value."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "const": "named"
            },
            "name": {
              "$ref": "#/$defs/QualifiedName"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "description": "A named struct or enum, by its qualified name."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "const": "dyn"
            },
            "trait": {
              "$ref": "#/$defs/QualifiedName"
            }
          },
          "required": [
            "kind",
            "trait"
          ],
          "description": "`dyn(Trait)`: any type that implements the trait."
        }
      ],
      "description": "A field type."
    },
    "QualifiedName": {
      "description": "A qualified name, `namespace::Name`; both parts are names.",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*::[A-Za-z][A-Za-z0-9_]*$",
      "not": {
        "pattern": "^(if|else|repeat|while|function|for|in|next|break|TRUE|FALSE|NULL|Inf|NaN|NA|NA_integer_|NA_real_|NA_character_|NA_complex_|self|Self|super|crate)::|::(if|else|repeat|while|function|for|in|next|break|TRUE|FALSE|NULL|Inf|NaN|NA|NA_integer_|NA_real_|NA_character_|NA_complex_|self|Self|super|crate)$"
      }
    },
    "RuleDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Name"
        },
        "invariant": {
          "$ref": "#/$defs/Logic"
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/Logic"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "invariant",
        "message"
      ],
      "description": "`rule(id, invariant, message, when = )`: what must hold.\n\nA rule holds when `when` is `false` or when a field that `invariant` or\n`when` reads is absent, and reports a violation when `invariant` is\n`false`. The IR stores both expressions as declared."
    },
    "Logic": {
      "description": "A JSONLogic expression, stored as its JSON value."
    },
    "Resolve": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "policy": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "policy"
          ],
          "additionalProperties": false,
          "description": "Absent is final."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "policy": {
              "type": "string",
              "const": "computed"
            },
            "expr": {
              "$ref": "#/$defs/Logic"
            }
          },
          "required": [
            "policy",
            "expr"
          ],
          "description": "`r8_resolve()` fills the value from an expression over other fields."
        },
        {
          "type": "object",
          "properties": {
            "policy": {
              "type": "string",
              "const": "runtime"
            }
          },
          "required": [
            "policy"
          ],
          "additionalProperties": false,
          "description": "`r8_resolve(x, context)` fills the value from data or the environment."
        }
      ],
      "description": "What an absent `option()` value means."
    },
    "CharacterType": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "type": [
            "string",
            "null"
          ],
          "description": "A regular expression in Rust `regex` syntax, compiled at declaration."
        },
        "enum": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Constraints of `type_character()`, and of the keys of `hashmap()`."
    },
    "Migration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MigrationStep"
          }
        }
      },
      "required": [
        "from_version",
        "steps"
      ],
      "description": "The steps that take a document from `from_version` to the next version."
    },
    "MigrationStep": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "type": "string",
              "const": "rename"
            },
            "from": {
              "$ref": "#/$defs/Name"
            },
            "to": {
              "$ref": "#/$defs/Name"
            }
          },
          "required": [
            "op",
            "from",
            "to"
          ],
          "description": "Renames a field."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "type": "string",
              "const": "add"
            },
            "field": {
              "$ref": "#/$defs/Name"
            },
            "value": true
          },
          "required": [
            "op",
            "field",
            "value"
          ],
          "description": "Adds a field with a value."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "type": "string",
              "const": "remove"
            },
            "field": {
              "$ref": "#/$defs/Name"
            }
          },
          "required": [
            "op",
            "field"
          ],
