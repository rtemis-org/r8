            "description": {
              "default": "",
              "type": "string"
            },
            "extends": {
              "anyOf": [
                {
                  "$ref": "#/$defs/QualifiedName"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The parent, whose fields are flattened into `fields`."
            },
            "extensions": {
              "additionalProperties": true,
              "description": "Namespaced extensions that R8 stores and exports and does not\ninterpret.",
              "type": "object"
            },
            "fields": {
              "items": {
                "$ref": "#/$defs/FieldDef"
              },
              "type": "array"
            },
            "kind": {
              "const": "struct",
              "type": "string"
            },
            "migrations": {
              "items": {
                "$ref": "#/$defs/Migration"
              },
              "type": "array"
            },
            "name": {
              "$ref": "#/$defs/Name"
            },
            "provenance": {
              "description": "Values carry a provenance record.",
              "type": "boolean"
            },
            "rules": {
              "items": {
                "$ref": "#/$defs/RuleDef"
              },
              "type": "array"
            },
            "s4": {
              "description": "Registered with `methods::setOldClass()`.",
              "type": "boolean"
            },
            "version": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "name",
            "version",
            "fields"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`new_enum()`: a sum type.",
          "properties": {
            "aliases": {
              "description": "Former qualified names, which readers accept.",
              "items": {
                "$ref": "#/$defs/QualifiedName"
              },
              "type": "array"
            },
            "description": {
              "default": "",
              "type": "string"
            },
            "extensions": {
              "additionalProperties": true,
              "type": "object"
            },
            "kind": {
              "const": "enum",
              "type": "string"
            },
            "migrations": {
              "items": {
                "$ref": "#/$defs/Migration"
              },
              "type": "array"
            },
            "name": {
              "$ref": "#/$defs/Name"
            },
            "tag": {
