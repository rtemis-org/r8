            "variants": {
              "items": {
                "$ref": "#/$defs/VariantDef"
              },
              "type": "array"
            },
            "version": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "name",
            "version",
            "variants"
          ],
          "type": "object"
        }
      ]
    },
    "VariantDef": {
      "description": "A variant of an enum.",
      "oneOf": [
        {
          "description": "A unit variant, written as its name.",
          "properties": {
            "shape": {
              "const": "unit",
              "type": "string"
            }
          },
          "required": [
            "shape"
          ],
          "type": "object"
        },
        {
          "description": "A struct variant, written as an object with the enum's tag member.",
          "properties": {
            "fields": {
              "items": {
                "$ref": "#/$defs/FieldDef"
              },
              "type": "array"
            },
            "rules": {
              "items": {
                "$ref": "#/$defs/RuleDef"
              },
              "type": "array"
            },
            "shape": {
              "const": "struct",
              "type": "string"
            }
          },
          "required": [
            "shape",
            "fields"
          ],
          "type": "object"
        },
        {
          "description": "A newtype variant, `variant(of = S)`: one value of the named struct\n`of`, written as that struct's object with the enum's tag member added.\nIn R the value is the struct's value itself.",
          "properties": {
