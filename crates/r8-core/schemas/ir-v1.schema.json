            "shape",
            "of"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/Name"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    }
  },
