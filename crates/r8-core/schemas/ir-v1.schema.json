        "field": {
          "$ref": "#/$defs/Name"
        }
      },
      "required": [
        "field",
        "expr"
      ],
      "type": "object"
    },
    "TraitDef": {
      "additionalProperties": false,
      "description": "`new_trait()`: behavior that types implement.",
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        },
        "methods": {
          "items": {
            "$ref": "#/$defs/MethodDef"
