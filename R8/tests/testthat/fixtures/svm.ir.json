{
  "$ir": 1,
  "namespace": "rtemis",
  "types": [
    {
      "kind": "struct",
      "name": "Svm",
      "description": "Support vector machine settings.",
      "version": 1,
      "fields": [
        {
          "name": "cost",
          "type": {
            "kind": "double",
            "exclusive_min": 0.0
          },
          "default": 1.0,
          "description": "Cost of a margin violation."
        },
        {
          "name": "kernel",
          "type": {
            "kind": "named",
            "name": "rtemis::Kernel"
          },
          "default": {
            "type": "Linear"
          },
          "description": "Kernel function."
        },
        {
          "name": "weights",
          "type": {
            "kind": "option",
            "inner": {
              "kind": "vec",
              "element": {
                "kind": "double",
                "min": 0.0
              }
            }
          },
          "description": "Case weights.",
          "external": true
        },
        {
          "name": "mtry",
          "type": {
            "kind": "option",
            "inner": {
              "kind": "integer",
              "min": 1
            },
            "resolve": {
              "policy": "runtime"
            }
          },
          "description": "Variables per split."
        }
      ],
      "rules": [
        {
          "id": "RBF_GAMMA",
          "invariant": {
            "<=": [
              {
                "var": "kernel.gamma"
              },
              10
            ]
          },
          "message": "gamma is at most 10."
        },
        {
          "id": "RBF_COST",
          "invariant": {
            "<=": [
              {
                "var": "cost"
              },
              100
            ]
          },
          "when": {
            "is_variant": [
              {
                "var": "kernel"
              },
              "Rbf"
            ]
          },
          "message": "cost is at most 100 with the Rbf kernel."
        }
      ]
    }
  ]
}
